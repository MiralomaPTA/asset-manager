# Copy to .env.local for development. Defaults work for local development with no Google setup.

# Public URL used in emailed links.
APP_URL=http://localhost:3000

# "local" (default): the Sheet as JSON files in ./.data/sheet, photos in ./.data/files,
# emails printed to the console and saved to ./.data/outbox.
# "google": Sheets, Drive and Gmail as equipment@miralomasf.com. Requires the GOOGLE_* values below.
# A production build refuses "local" (it would write to the serverless disk and lose everything)
# unless ALLOW_LOCAL_ADAPTERS_IN_PRODUCTION=1, which is only for trying `next start` on a laptop.
ADAPTERS=local

# Random secret for signing sessions and sign-in links. Required in production.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

FROM_EMAIL=equipment@miralomasf.com
FROM_NAME=Miraloma PTA Equipment
# Shown to people who need a human ("Questions? Email …"). Defaults to FROM_EMAIL.
CONTACT_EMAIL=

# --- Google Workspace (ADAPTERS=google) ---
# A service account with domain-wide delegation for the Drive, Sheets and gmail.send scopes.
# Use its own service account, not reimburse-me's, so a leaked key exposes one app.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON. Keep the literal \n line breaks when pasting into Vercel or GitHub.
GOOGLE_PRIVATE_KEY=
# Workspace user the service account acts as. Defaults to FROM_EMAIL.
GOOGLE_IMPERSONATE_EMAIL=equipment@miralomasf.com
# The "PTA equipment" folder in equipment@'s Drive; photos/ and returns/ are created inside it.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# The "PTA equipment" spreadsheet. Missing tabs and columns are created on first use.
GOOGLE_SHEET_ID=
